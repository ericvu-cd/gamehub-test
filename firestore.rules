rules_version = '2';

// =====================================================================
// 在地文化知識型互動平台 — Firestore 安全規則（GitHub 遷移版）
//
// 內容資料（Banner／任務／公告／徽章／證書字典／頭像清單）已搬到 GitHub，
// 不再存於 Firestore，因此本檔案不再有這些 collection 的規則。
//
// 金幣防作弊機制也跟著調整：因為任務的 entryCost／dailyRewardCap 已經
// 不在 Firestore，規則無法再逐筆核對交易金額是否正確，改用「每人每日
// 總量防護」（dailyGuard）——不管單筆金額多少，只要今天累計的淨變動量
// 或交易次數超過上限就擋下來。這是刻意的取捨，詳見「架構調整討論記錄.md」
// 第三輪確認的風險評估。
//
// ⚠️ 部署前請務必先用 Firebase Local Emulator Suite（firebase emulators:start）
// 搭配測試資料驗證這份規則。
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================================================
    // 共用工具函式
    // ===================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 以 UTC+8（台灣時區）為準，計算「今天是第幾天」的整數（epoch day）
    function utc8DayNumber() {
      return int((request.time.toMillis() + 8 * 60 * 60 * 1000) / (24 * 60 * 60 * 1000));
    }

    function changedKeys(before, after) {
      return after.diff(before).affectedKeys();
    }

    // ===================================================================
    // 使用者名稱唯一性：usernames/{username小寫}
    // ===================================================================

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ===================================================================
    // 管理者白名單：僅本人可讀自己的白名單狀態，任何人不可寫
    // （內容資料維護已改走 GitHub API，這裡的管理者權限現在只用於
    //  「編修使用者資料」這一項，見 8.3 節精神延續）
    // ===================================================================

    match /admins/{adminUid} {
      allow read: if isOwner(adminUid);
      allow write: if false;
    }

    // ===================================================================
    // 使用者資料：users/{uid}
    // ===================================================================

    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.level == 1
        && request.resource.data.coins == 0
        && request.resource.data.badges == []
        && request.resource.data.certificates == []
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.nickname.matches('^[A-Za-z0-9\u4e00-\u9fa5]+$');

      // 管理者：可自由編修任何使用者資料（金幣調整等人工修正用途）
      allow update: if isAdmin();

      // 一般使用者：僅限本人，且只能是下列其中一種「合法異動樣式」
      allow update: if isOwner(uid) && (
        isProfileOnlyEdit(resource.data, request.resource.data) ||
        isDailyLoginClaim(resource.data, request.resource.data) ||
        isTaskCostDeduction(resource.data, request.resource.data) ||
        isTaskRewardClaim(resource.data, request.resource.data) ||
        isCollectibleClaim(resource.data, request.resource.data)
      );

      // --- 樣式 1：只改暱稱／頭像／公告已讀時間，不動金幣與 dailyGuard ---
      function isProfileOnlyEdit(before, after) {
        return changedKeys(before, after).hasOnly(['nickname', 'avatarId', 'lastNewsViewedAt'])
          && (!('nickname' in after) || (
            after.nickname is string
            && after.nickname.size() >= 1
            && after.nickname.size() <= 20
            && after.nickname.matches('^[A-Za-z0-9\u4e00-\u9fa5]+$')
          ));
      }

      // --- 每日總量防護核心邏輯：驗證 dailyGuard 是否正確地反映了這次異動 ---
      // netDelta：這次異動造成 coins 的淨變化量（登入/獎勵為正，扣款為負，
      //           徽章證書核發等非金幣異動傳 0）
      function isValidDailyGuardUpdate(before, after, netDelta) {
        let today = utc8DayNumber();
        let prevGuard = before.get('dailyGuard', null);
        let isNewDay = prevGuard == null || prevGuard.day != today;
        let prevNet = isNewDay ? 0 : prevGuard.netChange;
        let prevTx = isNewDay ? 0 : prevGuard.txCount;
        let g = after.dailyGuard;

        return g.day == today
          && g.netChange == prevNet + netDelta
          && g.txCount == prevTx + 1
          && g.netChange <= 200   // DAILY_CAP
          && g.txCount <= 100;    // MAX_TX_PER_DAY
      }

      // --- 樣式 2：每日登入獎勵，同一自然日（UTC+8）只能領一次，固定 +10 ---
      function isDailyLoginClaim(before, after) {
        let today = utc8DayNumber();
        return before.get('lastDailyLoginDay', -1) != today
          && after.lastDailyLoginDay == today
          && after.coins == before.coins + 10
          && changedKeys(before, after).hasOnly(['lastDailyLoginDay', 'coins', 'dailyGuard', 'lastTransaction'])
          && after.lastTransaction.type == 'daily_login'
          && after.lastTransaction.amount == 10
          && isValidDailyGuardUpdate(before, after, 10);
      }

      // --- 樣式 3：進入任務扣款。因任務資料不在 Firestore，無法核對金額
      //     是否等於任務真實設定的 entryCost，只驗證餘額不會變負數，
      //     並受 dailyGuard 總量防護限制 ---
      function isTaskCostDeduction(before, after) {
        let tx = after.lastTransaction;
        let cost = before.coins - after.coins;
        return tx.type == 'task_cost'
          && cost > 0
          && after.coins >= 0
          && tx.amount == cost
          && changedKeys(before, after).hasOnly(['coins', 'dailyGuard', 'lastTransaction'])
          && isValidDailyGuardUpdate(before, after, -cost);
      }

      // --- 樣式 4：任務獎勵。同樣因任務資料不在 Firestore，
      //     不再核對個別任務的每日上限，改受全域 dailyGuard 限制 ---
      function isTaskRewardClaim(before, after) {
        let tx = after.lastTransaction;
        let amount = after.coins - before.coins;
        return tx.type == 'task_reward'
          && amount > 0
          && tx.amount == amount
          && changedKeys(before, after).hasOnly(['coins', 'dailyGuard', 'lastTransaction'])
          && isValidDailyGuardUpdate(before, after, amount);
      }

      // --- 樣式 5：任務授予的徽章／證書。不再核對來源任務是否正確
      //     （字典已搬到 GitHub，無法核對），僅受 dailyGuard 交易次數限制 ---
      function isCollectibleClaim(before, after) {
        let tx = after.lastTransaction;
        let changedBadges = changedKeys(before, after).hasOnly(['badges', 'dailyGuard', 'lastTransaction'])
          && after.badges.size() == before.badges.size() + 1;
        let changedCerts = changedKeys(before, after).hasOnly(['certificates', 'dailyGuard', 'lastTransaction'])
          && after.certificates.size() == before.certificates.size() + 1;
        return tx.type == 'collectible_award'
          && (changedBadges || changedCerts)
          && isValidDailyGuardUpdate(before, after, 0);
      }
    }

    // ===================================================================
    // 通行金幣收支明細：唯讀帳本，只能新增、不能修改或刪除
    // ===================================================================

    match /coinLedger/{uid}/entries/{entryId} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if (isOwner(uid) || isAdmin())
        && request.resource.data.type in ['daily_login', 'task_cost', 'task_reward', 'admin_adjust']
        && (request.resource.data.type != 'admin_adjust' || isAdmin())
        && request.resource.data.amount is number
        && request.resource.data.balanceAfter ==
             getAfter(/databases/$(database)/documents/users/$(uid)).data.coins;

      allow update, delete: if false;
    }

    // ===================================================================
    // 排行榜：leaderboard/{taskId}/entries/{uid}
    // ===================================================================

    match /leaderboard/{taskId}/entries/{entryUid} {
      allow read: if true;

      // 玩家本人寫入時，playerName 要符合跟暱稱一致的格式驗證，避免有人繞過網頁介面
      // 直接呼叫 API 塞入任意內容（例如惡意 HTML），這個排行榜是公開可讀的頁面。
      function isValidPlayerName(name) {
        return name is string
          && name.size() >= 1
          && name.size() <= 20
          && name.matches('^[A-Za-z0-9\u4e00-\u9fa5]+$');
      }

      allow create: if (isOwner(entryUid)
          && request.resource.data.scoreValue is number
          && isValidPlayerName(request.resource.data.playerName)
          && request.resource.data.scoreLabel is string
          && request.resource.data.scoreLabel.size() <= 40)
        || isAdmin();

      // 玩家本人只能覆寫成「更高分」；admin 可以改成任意分數（人工修正錯誤/作弊用）
      allow update: if (isOwner(entryUid)
          && request.resource.data.scoreValue is number
          && request.resource.data.scoreValue > resource.data.scoreValue
          && isValidPlayerName(request.resource.data.playerName)
          && request.resource.data.scoreLabel is string
          && request.resource.data.scoreLabel.size() <= 40)
        || (isAdmin() && request.resource.data.scoreValue is number);

      allow delete: if isAdmin();
    }

    // ===================================================================
    // 任務事件記錄：taskEventLogs/{logId}
    // 平台處理任務頁面送來的 complete/score 等訊息時，把關鍵結果（成功/被拒絕/
    // 例外/訊息被忽略）寫下來，方便事後在後台查，不用即時盯著 console 看。
    // 只能新增、不能改或刪，是唯讀事後稽核用的記錄，不是給玩家自己查看的資料。
    // ===================================================================

    match /taskEventLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.level in ['info', 'warn', 'error']
        && request.resource.data.at is number;

      allow update, delete: if false;
    }
  }
}
